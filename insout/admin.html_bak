<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>실시간 관리자 데스크 - IN'S OUT CASINO</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&family=Noto+Sans+KR:wght@500;700;800&display=swap" rel="stylesheet">
  
  <!-- Firebase SDK 호환 버전 로드 -->
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

  <style>
    :root {
      --bg-dark: #0b0d13;
      --card-bg: rgba(23, 27, 38, 0.95);
      --card-border: rgba(212, 175, 55, 0.25);
      --gold-primary: #f5c842;
      --neon-cyan: #00e5ff;
      --accent-red: #ff5252;
      --text-main: #f0f2f5;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Noto Sans KR', sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      padding: 0 12px 50px;
      line-height: 1.4;
    }

    /* 잠금 화면 */
    .lock-overlay {
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      background: #0b0d13;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .lock-box {
      width: 100%;
      max-width: 320px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 24px 20px;
      text-align: center;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
    }

    .lock-title {
      font-size: 17px;
      font-weight: 800;
      color: var(--gold-primary);
      margin-bottom: 6px;
    }

    .lock-sub {
      font-size: 12px;
      color: #8c93a3;
      margin-bottom: 18px;
    }

    .lock-input {
      width: 100%;
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(212, 175, 55, 0.3);
      border-radius: 8px;
      padding: 12px;
      color: #fff;
      font-size: 15px;
      text-align: center;
      outline: none;
      margin-bottom: 12px;
    }

    .lock-input:focus { border-color: var(--gold-primary); }

    .lock-btn {
      width: 100%;
      background: var(--gold-primary);
      color: #0b0d13;
      border: none;
      border-radius: 8px;
      padding: 12px;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
    }

    .error-msg {
      color: var(--accent-red);
      font-size: 12px;
      margin-top: 8px;
      display: none;
      font-weight: 700;
    }

    /* 상단 네비 */
    .top-nav {
      position: sticky;
      top: 0;
      background: rgba(11, 13, 19, 0.95);
      backdrop-filter: blur(10px);
      padding: 12px 4px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(212, 175, 55, 0.2);
      margin-bottom: 14px;
      z-index: 10;
    }

    .back-btn {
      color: var(--gold-primary);
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 700;
    }

    .sync-status {
      font-size: 11px;
      color: #00ffaa;
      font-weight: 700;
    }

    .reset-btn {
      background: rgba(255, 82, 82, 0.15);
      border: 1px solid rgba(255, 82, 82, 0.3);
      color: #ff8a80;
      font-size: 11px;
      padding: 4px 8px;
      border-radius: 6px;
      font-weight: 700;
      cursor: pointer;
    }

    .page-title {
      font-size: 18px;
      font-weight: 800;
      color: #fff;
      margin-bottom: 4px;
    }

    .page-sub {
      font-size: 11.5px;
      color: #8c93a3;
      margin-bottom: 14px;
    }

    /* 명단 카드 */
    .list-container {
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 500px;
      margin: 0 auto;
    }

    .user-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      padding-bottom: 8px;
    }

    .user-name-box {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .user-idx {
      font-size: 11px;
      font-weight: 800;
      color: var(--gold-primary);
      width: 20px;
    }

    .name-input {
      background: transparent;
      border: none;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.2);
      color: #fff;
      font-size: 15px;
      font-weight: 700;
      width: 100px;
      padding: 2px 0;
      outline: none;
    }

    .name-input:focus {
      border-bottom-color: var(--gold-primary);
    }

    .rebuy-counter {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 0, 0, 0.3);
      padding: 3px 8px;
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .count-label { font-size: 11px; color: #8c93a3; }
    .count-val {
      font-size: 14px;
      font-weight: 800;
      color: var(--gold-primary);
      min-width: 16px;
      text-align: center;
    }

    .btn-step {
      width: 24px; height: 24px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: #171b26;
      color: #fff;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
    }

    .card-bottom {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .toggle-btn {
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      padding: 7px 6px;
      font-size: 11px;
      font-weight: 700;
      color: #8c93a3;
      text-align: center;
      cursor: pointer;
      user-select: none;
    }

    .toggle-btn.active-overcooked {
      background: rgba(0, 229, 255, 0.15);
      border-color: var(--neon-cyan);
      color: var(--neon-cyan);
    }

    .toggle-btn.active-nintendo {
      background: rgba(255, 82, 82, 0.15);
      border-color: var(--accent-red);
      color: #ff8a80;
    }
  </style>
</head>
<body>

  <!-- 비밀번호 인증 잠금 화면 -->
  <div id="lockOverlay" class="lock-overlay">
    <div class="lock-box">
      <div class="lock-title">🔒 ADMIN VERIFICATION</div>
      <div class="lock-sub">관리자 전용 접근 화면입니다.</div>
      <input type="password" id="pwInput" class="lock-input" placeholder="비밀번호 입력">
      <button class="lock-btn" onclick="checkPW()">접속하기</button>
      <div id="errorMsg" class="error-msg">비밀번호가 올바르지 않습니다.</div>
    </div>
  </div>

  <!-- 상단 네비 -->
  <div class="top-nav">
    <a href="index.html" class="back-btn">‹ 메인으로</a>
    <span class="sync-status">● 실시간 동기화 켜짐</span>
    <button class="reset-btn" onclick="resetAll()">기록 초기화</button>
  </div>

  <div style="max-width: 500px; margin: 0 auto;">
    <div class="page-title">⚙️ 카지노 운영 관리 데스크</div>
    <div class="page-sub">모든 관리자 화면에 1초 이내로 실시간 자동 동기화됩니다.</div>
  </div>

  <div id="userList" class="list-container"></div>

  <script>
    const firebaseConfig = {
      apiKey: "AIzaSyD2iFUXGnZzag8M51sQSTo27tPMsvAS5_Y",
      authDomain: "insout-898fa.firebaseapp.com",
      databaseURL: "https://insout-898fa-default-rtdb.asia-southeast1.firebasedatabase.app",
      projectId: "insout-898fa",
      storageBucket: "insout-898fa.firebasestorage.app",
      messagingSenderId: "116213907100",
      appId: "1:116213907100:web:f4d3bb35c4b6a758c97759"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();
    const adminRef = db.ref('casino_users');

    const defaultNames = [
      "김민기", "이용규", "김성기", "이주명", "이나예", 
      "정홍주", "허채윤", "이경준", "김나희", "김보경", 
      "이재준", "오준성", "문기원", "김수린", "박지윤", 
      "김주한", "최성규", "조보현", "노윤탁", "신다슬",
      "", "", "", ""
    ];

    let currentUsers = [];

    // 비밀번호 체크 (escape로 변경)
    function checkPW() {
      const input = document.getElementById('pwInput').value;
      if (input === "escape") {
        document.getElementById('lockOverlay').style.display = 'none';
        sessionStorage.setItem('ins_out_auth', 'ok');
      } else {
        document.getElementById('errorMsg').style.display = 'block';
      }
    }

    if (sessionStorage.getItem('ins_out_auth') === 'ok') {
      document.getElementById('lockOverlay').style.display = 'none';
    }

    document.getElementById('pwInput').addEventListener("keyup", function(e) {
      if (e.key === "Enter") checkPW();
    });

    // Firebase 실시간 리스너
    adminRef.on('value', (snapshot) => {
      const data = snapshot.val();
      if (!data) {
        const initData = defaultNames.map((name, i) => ({
          id: i + 1,
          name: name,
          overcooked: false,
          nintendoLimit: false,
          rebuyinCount: 0
        }));
        adminRef.set(initData);
      } else {
        currentUsers = data;
        renderList(currentUsers);
      }
    });

    function renderList(users) {
      const container = document.getElementById('userList');
      container.innerHTML = '';

      users.forEach((user, index) => {
        const card = document.createElement('div');
        card.className = 'user-card';
        card.innerHTML = `
          <div class="card-top">
            <div class="user-name-box">
              <span class="user-idx">${String(index + 1).padStart(2, '0')}</span>
              <input type="text" class="name-input" value="${user.name || ''}" placeholder="이름 입력" onchange="updateName(${index}, this.value)">
            </div>
            <div class="rebuy-counter">
              <span class="count-label">리바인</span>
              <button class="btn-step" onclick="changeRebuy(${index}, -1)">-</button>
              <span class="count-val">${user.rebuyinCount || 0}</span>
              <button class="btn-step" onclick="changeRebuy(${index}, 1)">+</button>
            </div>
          </div>
          <div class="card-bottom">
            <div class="toggle-btn ${user.overcooked ? 'active-overcooked' : ''}" onclick="toggleOvercooked(${index})">
              🍳 오버쿡 무료: <strong>${user.overcooked ? '완료' : '미달성'}</strong>
            </div>
            <div class="toggle-btn ${user.nintendoLimit ? 'active-nintendo' : ''}" onclick="toggleNintendo(${index})">
              🎮 5연승 제한: <strong>${user.nintendoLimit ? '해당' : '정상'}</strong>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function updateName(idx, val) {
      adminRef.child(idx).child('name').set(val.trim());
    }

    function changeRebuy(idx, delta) {
      const current = currentUsers[idx].rebuyinCount || 0;
      const next = Math.max(0, current + delta);
      adminRef.child(idx).child('rebuyinCount').set(next);
    }

    function toggleOvercooked(idx) {
      const current = !currentUsers[idx].overcooked;
      adminRef.child(idx).child('overcooked').set(current);
    }

    function toggleNintendo(idx) {
      const current = !currentUsers[idx].nintendoLimit;
      adminRef.child(idx).child('nintendoLimit').set(current);
    }

    function resetAll() {
      if (confirm("모든 운영진 화면의 카운트와 체크 기록이 초기화됩니다. 계속하시겠습니까?")) {
        const updated = currentUsers.map(u => ({
          ...u,
          overcooked: false,
          nintendoLimit: false,
          rebuyinCount: 0
        }));
        adminRef.set(updated);
      }
    }
  </script>
</body>
</html>